    _, err = get_enrichment_table_record("sagan_bluedot_proxy", {"ip": .sagan_ip_4})
    if err == null { .sagan_bluedot_proxy_4 = true }
}
if exists(.sagan_ip_5) {
    _, err = get_enrichment_table_record("sagan_bluedot_proxy", {"ip": .sagan_ip_5})
    if err == null { .sagan_bluedot_proxy_5 = true }
