# Hand-written fixtures covering every construct the converter handles.
# These are original works written for this test suite, not extracts from the
# upstream sagan-rules corpus, so this file carries no third-party licence.

# --- basic text matching ---------------------------------------------------
alert any $EXTERNAL_NET any -> $HOME_NET any (msg:"[SSH] Authentication failure"; program: sshd|openssh; content:"authentication failure"; nocase; content:!"frank"; classtype: attempted-admin; reference:url,example.org/ssh; sid:9000001; rev:1;)

# --- hex escapes and literal wildcards -------------------------------------
alert any any any -> any any (msg:"[WEB] Suspicious user agent"; program: *apache*; content:"User Agent|3a| scanner"; content:"100*"; classtype: suspicious-traffic; sid:9000002; rev:1;)

# --- meta_content with an inline list --------------------------------------
alert any any any -> any any (msg:"[AUTH] Privileged account used"; program: sudo; meta_content:"USER=%sagan%",root,admin; meta_nocase; classtype: user-activity; sid:9000003; rev:1;)

# --- pcre ------------------------------------------------------------------
alert any any any -> any any (msg:"[SYSLOG] Out of disk space"; pcre:"/file system full|No space left on device/i"; classtype: hardware-event; sid:9000004; rev:2;)

# --- json, portable output -------------------------------------------------
alert any any any -> any any (msg:"[CLOUD] Trail created"; program: cloudtrail.amazonaws.com; json_content:".eventName","CreateTrail"; json_content:!".userIdentity.type","AssumedRole"; json_meta_content:".awsRegion",us-east-1,eu-west-1; classtype: user-activity; metadata: mitre_technique_id T1078, mitre_tactic_id TA0005; sid:9000005; rev:1;)

# --- json_map redirects the message search ---------------------------------
alert any any any -> any any (msg:"[WINDOWS] Service installed"; program: eventlog; json_map:"message",".RenderedDescription"; json_map:"event_id",".EventID"; event_id: 7045; content:"service was installed"; nocase; classtype: suspicious-traffic; sid:9000006; rev:1;)

# --- numeric json value, must not carry |cased -----------------------------
alert any any any -> any any (msg:"[AZURE] Interactive sign-in success"; program: azureEventHub; json_content:".resultType","0"; classtype: user-activity; sid:9000007; rev:1;)

# --- after correlation, group-by from json_map -----------------------------
alert any any any -> any any (msg:"[CLOUD] Console login brute force"; program: signin.amazonaws.com; json_map:"src_ip",".sourceIPAddress"; json_content:".errorMessage","Failed authentication"; after: track by_src, count 5, seconds 300; classtype: attempted-admin; sid:9000008; rev:1;)

# --- after correlation falling back to the syslog sender -------------------
alert any any any -> any any (msg:"[PBX] Repeated registration failure"; program: asterisk; content:"Registration from"; after: track by_src, count 10, seconds 600; threshold: type suppress, track by_src, count 5, seconds 900; classtype: attempted-admin; sid:9000009; rev:1;)

# --- xbits pair: setter then tester ----------------------------------------
alert any any any -> any any (msg:"[AUTH] Brute force detected"; program: sshd; json_content:".msg","Failed password"; json_map:"src_ip",".ip"; xbits: set,brute_force,track ip_src, expire 21600; classtype: attempted-admin; sid:9000010; rev:1;)
alert any any any -> any any (msg:"[AUTH] Login success after brute force"; program: sshd; json_content:".msg","Accepted password"; json_map:"src_ip",".ip"; xbits: isset,brute_force,track ip_src; classtype: correlated-attack; sid:9000011; rev:1;)

# --- priority overrides classtype even when it comes first -----------------
alert any any any -> any any (msg:"[TEST] Priority beats classtype"; priority: 1; program: test; content:"x"; classtype: hardware-event; sid:9000012; rev:1;)

# --- drop action, converted with a degradation -----------------------------
drop any any any -> any any (msg:"[TEST] Drop action"; program: test; content:"y"; classtype: user-activity; sid:9000013; rev:1;)

# --- raw text search on a JSON-bodied event, which can never match ----------
alert any any any -> any any (msg:"[TEST] Raw search on a JSON event"; program: test; json_content:".a","b"; content:"unreachable"; classtype: user-activity; sid:9000022; rev:1;)

# --- pcre the Rust engine rejects raw but the converter rewrites -------------
# A literal '{' (not a counted repetition): escaped, not refused.
alert any any any -> any any (msg:"[TEST] Literal brace pcre"; program: test; pcre:"/count {\d}/"; classtype: user-activity; sid:9000023; rev:1;)
# A numbered subroutine call: inlined, not refused.
alert any any any -> any any (msg:"[TEST] Subroutine pcre"; program: test; pcre:"/ip=(10|172)(?1)/"; classtype: user-activity; sid:9000024; rev:1;)
# The whole-string 'does not contain X' idiom: a negated search, not refused.
alert any any any -> any any (msg:"[TEST] Tempered negation pcre"; program: test; pcre:"/^((?!denied).)*$/"; classtype: user-activity; sid:9000025; rev:1;)
# An inert flag Sagan silently ignores: kept, not refused.
alert any any any -> any any (msg:"[TEST] Inert pcre flag"; program: test; pcre:"/failed/iH"; classtype: user-activity; sid:9000026; rev:1;)

# --- by_string tracks username; refused by default, recovered under enriched ---
alert any any any -> any any (msg:"[TEST] by_string correlation"; program: test; content:"x"; parse_src_ip: 1; after: track by_src&by_string, count 3, seconds 60; classtype: user-activity; sid:9000027; rev:1;)

# --- bluedot: closed CTI substituted by open-source per-category feeds (enriched) ---
alert any any any -> any any (msg:"[TEST] Bluedot substitution"; program: test; content:"x"; parse_src_ip: 1; bluedot: type ip_reputation, track by_src, none, Malicious,Tor; classtype: trojan-activity; sid:9000029; rev:1;)

# --- refusals --------------------------------------------------------------
alert any any any -> any any (msg:"[TEST] Positional constraint"; program: test; content:"bob"; depth: 10; classtype: user-activity; sid:9000014; rev:1;)
alert any any any -> any any (msg:"[TEST] External enrichment"; program: test; content:"x"; parse_src_ip: 1; country_code: track by_src, isnot US; classtype: user-activity; sid:9000015; rev:1;)
alert any any any -> any any (msg:"[TEST] Recurring time window"; program: test; content:"x"; alert_time: days 0123456, hours 0800-1800; classtype: user-activity; sid:9000016; rev:1;)
alert any any any -> any any (msg:"[TEST] Negative correlation"; program: test; content:"x"; xbits: isnotset,windows_reboot,track ip_src; classtype: user-activity; sid:9000017; rev:1;)
alert any any any -> any any (msg:"[TEST] Group-by from regex extraction"; program: test; content:"x"; parse_src_ip: 1; after: track by_src, count 5, seconds 300; classtype: user-activity; sid:9000018; rev:1;)
alert any any any -> any any (msg:"[TEST] Base64 field decode"; program: test; json_content:".payload","BOB"; json_decode_base64; classtype: user-activity; sid:9000019; rev:1;)
pass any any any -> any any (msg:"[TEST] Global suppression"; program: test; content:"ignore me"; classtype: user-activity; sid:9000020; rev:1;)
# country_code tracking an address the engine can never validate (no parse_src_ip,
# json_map or normalize): dead in Sagan, so refused as never-fires, not enrichment.
alert any any any -> any any (msg:"[TEST] Dead country_code"; program: test; content:"x"; country_code: track by_src, isnot US; classtype: user-activity; sid:9000028; rev:1;)

# --- commented out, must be counted but not converted ----------------------
#alert any any any -> any any (msg:"[TEST] Disabled"; program: test; content:"z"; sid:9000021; rev:1;)
